---
title: "A0  Master overview  —  pipeline + the three nested loops + the point-light output"
config:
  theme: neutral
  themeVariables:
    clusterBkg: "#f5f5f5"
    clusterBorder: "#000000"
    lineColor: "#000000"
    fontFamily: "Helvetica, Arial, sans-serif"
---
flowchart LR
  %% ---------------- INPUT (two cameras shown individually) ----------------
  cam1["Camera 1<br/>RTSP 25 fps"]
  cam2["Camera 2<br/>RTSP 25 fps"]
  cam1 --> yolo["YOLO detect + fuse<br/>-> floor x, y"]
  cam2 --> yolo
  yolo -->|"OSC :7000<br/>/tracker/count<br/>/tracker/person"| CTRL

  %% ---------------- CONTROLLER: 3 nested loops (containment = governs) ----------------
  subgraph CTRL["lightController_osc.py"]
    direction TB
    subgraph L3["LOOP 3 · SELF-TUNING"]
      direction TB
      l3note["<b>SELF-TUNING</b><br/>──────────<br/><i>hours → days · retunes the coefficients</i><br/>meta-review 3x/day + daily learning · friction = interaction budget<br/>───── 12 meta-parameters (the 'personality') ─────<br/>responsiveness · energy · attention_span<br/>sociability · exploration · memory<br/>brightness_global · speed_global · pulse_global<br/>follow_speed_global · dwell_influence · idle_trend_weight"]
      subgraph L2["LOOP 2 · ANTICIPATION"]
        direction TB
        l2note["<b>ANTICIPATION</b><br/>──────────<br/><i>seconds → hours · sets the context</i><br/>trends: 1 / 5 / 30 / 60 min windows<br/>flow tracker: 30 s window<br/>bias idle/flow · pre-position the light"]
        subgraph L1["LOOP 1 · REACTION"]
          direction TB
          l1note["<b>REACTION</b><br/>──────────<br/><i>~33 ms / 30 Hz · writes the light</i><br/>mode: idle / flow / aware / engaged / crowd<br/>gestures + dwell phases<br/>the only loop that writes the light state"]
        end
      end
    end
  end

  CTRL ==>|"sets light state<br/>every frame"| OUT
  CTRL -->|"WebSocket :8765"| web["Three.js<br/>web viewer"]

  %% ---------------- MEMORY (alongside, feeds outer loops) ----------------
  db[("SQLite memory<br/>events · light_behavior<br/>tuning audit")]
  CTRL <-->|"writes events · reads trends + 8 h history"| db

  %% ---------------- OUTPUT: point-light state ----------------
  subgraph OUT["POINT LIGHT"]
    direction TB
    icon["[ rendered light / panels<br/>icon -- TBD ]"]
    state["<b>recomputed every frame (30 Hz)</b><br/>PointLight state (~9 values)<br/>position: x, y, z<br/>intensity: current_brightness<br/>falloff: radius + scale sx,sy,sz + rotation<br/>move_speed"]
    icon --> state
  end

  %% ---------------- 12 INDIVIDUAL PANELS (one DMX byte each, via Art-Net :6454) ----------------
  OUT ==>|"Art-Net :6454<br/>one DMX byte (0-255) per panel"| PANELS
  subgraph PANELS["12 LED panels"]
    direction LR
    subgraph U0["Unit 0"]
      direction TB
      p0["panel 0"]
      p1["panel 1"]
      p2["panel 2"]
    end
    subgraph U1["Unit 1"]
      direction TB
      p3["panel 3"]
      p4["panel 4"]
      p5["panel 5"]
    end
    subgraph U2["Unit 2"]
      direction TB
      p6["panel 6"]
      p7["panel 7"]
      p8["panel 8"]
    end
    subgraph U3["Unit 3"]
      direction TB
      p9["panel 9"]
      p10["panel 10"]
      p11["panel 11"]
    end
  end

  %% ---------------- STYLES (black / white / grey) ----------------
  classDef io fill:#ffffff,stroke:#000000,color:#000000;
  classDef proc fill:#e8e8e8,stroke:#000000,color:#000000;
  classDef out fill:#cccccc,stroke:#000000,color:#000000;
  classDef mem fill:#ffffff,stroke:#000000,color:#000000;
  classDef ph fill:#ffffff,stroke:#666666,color:#333333,stroke-dasharray:4 3;
  classDef panel fill:#bdbdbd,stroke:#000000,color:#000000;
  class cam1,cam2,yolo,web io;
  class l1note,l2note,l3note proc;
  class state out;
  class db mem;
  class icon ph;
  class p0,p1,p2,p3,p4,p5,p6,p7,p8,p9,p10,p11 panel;

  %% subgraph (cluster) backgrounds — keep greyscale; nested loops get progressively darker
  style CTRL fill:#fafafa,stroke:#000000,color:#000000;
  style L3 fill:#f0f0f0,stroke:#000000,color:#000000;
  style L2 fill:#e6e6e6,stroke:#000000,color:#000000;
  style L1 fill:#dcdcdc,stroke:#000000,color:#000000;
  style OUT fill:#fafafa,stroke:#000000,color:#000000;
  style PANELS fill:#fafafa,stroke:#000000,color:#000000;
  style U0 fill:#f0f0f0,stroke:#000000,color:#000000;
  style U1 fill:#f0f0f0,stroke:#000000,color:#000000;
  style U2 fill:#f0f0f0,stroke:#000000,color:#000000;
  style U3 fill:#f0f0f0,stroke:#000000,color:#000000;
