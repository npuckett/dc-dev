---
title: "A7.3b  RESIST worked example  —  one proposed nudge to 'energy' through the friction stack"
---
flowchart TB
  start["PROPOSED delta from gradient + regime<br/>energy: +0.050   (current = 0.62, home = 0.45)"]

  start --> s1
  s1["STAGE 1 . MEAN REVERSION (adds a pull toward home)<br/>dist = home - cur = 0.45 - 0.62 = -0.17<br/>pull = (0.015 + 0.04 x 0.17) x 1.0 = 0.0218<br/>reversion_delta = dist x pull = -0.17 x 0.0218 = -0.0037<br/><b>delta: +0.050 - 0.0037 = +0.0463</b>"]

  s1 --> s2
  s2["STAGE 2 . STEP CLAMP (personality cap +/- 0.012)<br/>+0.0463 exceeds +0.012<br/><b>delta clamped to +0.012</b>  . (>= 0.006, survives)"]

  s2 --> s3{"STAGE 3 . BUDGET<br/>cost = |0.012| x cost_scale(30) = 0.36<br/>budget enough?"}
  s3 -->|"budget = 120 (ample)<br/>cost 0.36 << 120"| pay["budget -= 0.36  ->  119.64<br/><b>delta stays +0.012</b>"]
  s3 -->|"budget = 0.18 (low)<br/>cost 0.36 > 0.18"| thr["scale = 0.18 / total_cost<br/>e.g. x0.5  ->  <b>delta +0.006</b><br/>budget -> 0 (throttled)"]

  pay --> s4
  thr --> s4
  s4["STAGE 4 . VALUE CLAMP (range 0.0-0.80, floor 0.25)<br/>0.62 + 0.012 = 0.632  (within bounds)<br/><b>applied: energy 0.62 -> 0.632</b>"]

  s4 --> done["NET RESULT<br/>asked for +0.050, applied +0.012 (ample budget)<br/>or +0.006 (throttled)<br/><i>friction turned a 0.050 grab into a ~0.012 step</i>"]

  refill["budget refill = 200 / 600 s = 0.33 / s<br/>+1.5/s bonus when someone is engaged"] -.->|"regenerates between cycles"| s3

  classDef resist fill:#2a2030,stroke:#c9a0ff,color:#fff;
  classDef io fill:#1f2a44,stroke:#9db2ff,color:#fff;
  classDef res fill:#1f3a2a,stroke:#9dffc0,color:#fff;
  class s1,s2,s3,s4 resist;
  class start io;
  class done res;
